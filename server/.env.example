# dev | prod
APP_ENV=dev
PORT=3000
# Optional overrides (same pattern): unset → APP_ENV default
# BIND_ADDR defaults: dev=0.0.0.0, prod=127.0.0.1
# BIND_ADDR=127.0.0.1
DATABASE_URL=sqlite://data/dev.db?mode=rwc
# CORS_ORIGINS: comma-separated. Empty = no CORS.
# Unset defaults: dev=http://localhost:5173, prod=none (same-origin via nginx)
# CORS_ORIGINS=http://localhost:5173
